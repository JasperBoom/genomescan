Bootstrap: docker
From: python:3.8-slim

%help
Recipe written by Jasper Boom, GenomeScan.
This recipe will build a container that can run phen2gene.

%labels
Author Jasper Boom
Maintainer Jasper Boom
Version v1.2.3

%post
  # Stop on first error to avoid half-configured images.
  set -e

  # Avoid interactive apt prompts during build.
  export DEBIAN_FRONTEND=noninteractive

  # System dependencies.
  # Keep this Debian-based image on Debian repos only.
  apt-get update -y
  apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    g++ \
    gcc \
    gfortran \
    git \
    libatlas-base-dev \
    libffi-dev \
    libhdf5-dev \
    libicu-dev \
    liblapack-dev \
    libpng-dev \
    openssl \
    python3-tk \
    sqlite3 \
    wget \
    xz-utils \
    zip \
    zlib1g \
    zlib1g-dev \
    musl-dev

  # Reduce image size by removing apt cache/lists.
  rm -rf /var/lib/apt/lists/*

  # Python dependencies.
  python -m pip install --upgrade pip
  pip install --no-cache-dir \
    matplotlib>=3.1.2 \
    networkx>=2.4 \
    numpy>=1.17.3 \
    pandas>=0.25.3 \
    scipy>=1.3.2 \
    seaborn>=0.9.0 \
    setuptools>=42.0.2 \
    wheel>=0.33.6 \
    tornado>=6.0.3 \
    statsmodels>=0.10.2 \
    six>=1.13.0 \
    python-dateutil>=2.8.1 \
    pyparsing>=2.4.5 \
    patsy>=0.5.1 \
    kiwisolver>=1.1.0 \
    decorator>=4.4.1 \
    cycler>=0.10.0 \
    certifi>=2019.11.28

  # Phen2Gene installation.
  # Create expected install directories used by setup.sh prompts.
  mkdir -p /root/Knowledgebase /root/Scripts

  # Clone upstream repository.
  git clone --recursive https://github.com/WGLab/Phen2Gene.git /root/Phen2Gene
  cd /root/Phen2Gene
  # Pin to a known good commit or tag.
  git checkout 1.2.3

  # Provide setup inputs non-interactively.
  printf "/root/Knowledgebase\n/root/Scripts\n" | bash ./setup.sh

  # Entrypoint convenience.
  # Use executable permissions without world-writable bits.
  chmod 755 /root/Scripts/phen2gene.py

  # Add stable command names to PATH.
  ln -sf /root/Scripts/phen2gene.py /usr/local/bin/phen2gene.py
  ln -sf /root/Scripts/phen2gene.py /usr/local/bin/phen2gene